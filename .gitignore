# データファイル
*.rds
*.RData
*.csv
*.rda
*.xlsx
*.tsv
!paper/gpt_review/gdc_manifest_rebc_thyr_star_counts.tsv
*.txt
*.gtf
*.sqlite
data/*
!data/.gitkeep
!data/*/
!data/*/.gitkeep
output/*
!output/.gitkeep
!output/*/
!output/*/.gitkeep

# 画像・レポートファイル
*.png
*.jpg
*.pdf
*.html
plots/
reports/

# R関連の一時ファイル
.Rhistory
.Ruserdata
.Rproj.user/

# OS関連
.DS_Store
Thumbs.db

# === v7 specific ===
# GDC download directories (explicit)
analysis_v7/data/raw/gdc/

# Logs directory (execution records)
analysis_v7/logs/
!analysis_v7/logs/.gitkeep

# Keep manifests for reproducibility
!analysis_v7/data/raw/manifest_*.tsv

# Session info logs
session_info_*.txt

# Keep directory structure
!**/.gitkeep
# === Additional exclusions ===
# Compressed data files
*.tar.gz
*.gtf.gz
*.gz

# GDC client binaries
gdc-client*

# Remove manifest inclusion (too many files)
# Manifests should be documented in README instead
analysis_v7/data/raw/manifest_*.tsv

# === new top-level work dirs (raw/processed/output/meta) ===
# 作業ディレクトリの中身は追跡しないが、器(.gitkeep)は残す
raw/*
!raw/.gitkeep
# サブディレクトリ(expression/clinical/reference)の器も残す。
# 一旦ディレクトリを再包含し、中身は再度無視、.gitkeepだけ通す。
!raw/*/
raw/*/*
!raw/*/.gitkeep
processed/*
!processed/.gitkeep
output/*
!output/.gitkeep
meta/*
!meta/.gitkeep

# ルート直下の旧生成物の退避先（拡張子問わず全体を除外）
_archive_root/

# Baseline reference CSVs are tracked (exception to the global *.csv ignore)
!tests/reference/baseline_20260807/*.csv

# The figure/table manifest is a tracked management file (reorg plan v2 s2.6;
# recorded as a narrow exception to the global *.csv ignore, like the baseline)
!figures/manifest.csv

# Canonical IREP Assigned Share values (researcher-computed input, not
# re-downloadable; reorg plan v2 B.11 — narrow exception like the baseline)
!raw/clinical/thyr_irep_assigned_share.csv

# Build inputs for the canonical image are code, not data (exception to the
# global *.tsv ignore; the Dockerfile COPYs this file)
!docker/versions.tsv

# Diagnostics outputs are generated measurements (same handling as processed/)
diagnostics/output/

# Curated external gene lists are a hand-made input with cited sources, not a
# generated measurement: the anchor cross-reference is not reproducible
# without it (narrow exception like the IREP input above)
!diagnostics/external_gene_anchors.csv

# Submission-assembly copies retained with the GPT review deliverables.
!paper/gpt_review/supplementary_files/
!paper/gpt_review/supplementary_files/**
